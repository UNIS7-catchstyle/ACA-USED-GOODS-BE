DB_HOST=localhost
DB_PORT=3306
DB_NAME=aca_used_goods
DB_USERNAME=aca
DB_PASSWORD=1234
DB_ROOT_PASSWORD=root1234

# Base64-encoded, decodes to 64+ bytes. Generate with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-base64-secret-of-64-bytes-or-more
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

# Local profile uses local disk storage by default (see application-local.yml).
STORAGE_LOCAL_BASE_DIR=./uploads
STORAGE_LOCAL_BASE_URL=http://localhost:8080/uploads

# Prod profile uses S3 (see application-prod.yml). public-url-prefix is optional
# (e.g. a CloudFront domain) — leave unset to use the bucket's direct S3 URL.
STORAGE_S3_BUCKET=change-me-bucket-name
STORAGE_S3_REGION=ap-northeast-2
STORAGE_S3_ACCESS_KEY=change-me
STORAGE_S3_SECRET_KEY=change-me
STORAGE_S3_PUBLIC_URL_PREFIX=
